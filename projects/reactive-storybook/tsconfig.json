{
  "extends": "../../configurations/config-typescript/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": [
    "node_modules",
    "lib",
    "build",
    "storybook-static",
    "scripts",
    "acceptance-tests",
    "webpack",
    "jest",
    "src/setupTests.ts",
    "jest.config.js"
  ]
}
