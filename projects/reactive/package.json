{
  "name": "@reformjs/reactive",
  "version": "0.0.3-rc.12",
  "description": "",
  "type": "module",
  "main": "index.js",
  "private": true,
  "scripts": {
    "clean": "rimraf dist",
    "build:js": "pnpm rollup --config rollup.config.mjs",
    "build:styles": "make-dir ./dist/styles/scss && ncp ./src/styles ./dist/styles/scss && sass ./dist/styles/scss/index.scss:./dist/styles/css/index.css",
    "build:assets": "ncp ./src/assets ./dist/assets",
    "build": "npm run clean && npm run build:js && npm run build:styles && npm run build:assets",
    "lint": "npx eslint ./src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "/dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./arrangement/infinite-list": {
      "import": "./dist/components/arrangement/infinite-list/index.mjs",
      "types": "./dist/components/arrangement/infinite-list/index.d.ts"
    },
    "./arrangement/layout": {
      "import": "./dist/components/arrangement/layout/index.mjs",
      "types": "./dist/components/arrangement/layout/index.d.ts"
    },
    "./arrangement/scaling-container": {
      "import": "./dist/components/arrangement/scaling-container/index.mjs",
      "types": "./dist/components/arrangement/scaling-container/index.d.ts"
    },
    "./arrangement/tab-bar": {
      "import": "./dist/components/arrangement/tab-bar/index.mjs",
      "types": "./dist/components/arrangement/tab-bar/index.d.ts"
    },
    "./arrangement/tray": {
      "import": "./dist/components/arrangement/tray/index.mjs",
      "types": "./dist/components/arrangement/tray/index.d.ts"
    },
    "./controls/button": {
      "import": "./dist/components/controls/button/index.mjs",
      "types": "./dist/components/controls/button/index.d.ts"
    },
    "./controls/date-picker": {
      "import": "./dist/components/controls/date-picker/index.mjs",
      "types": "./dist/components/controls/date-picker/index.d.ts"
    },
    "./controls/drop-down": {
      "import": "./dist/components/controls/drop-down/index.mjs",
      "types": "./dist/components/controls/drop-down/index.d.ts"
    },
    "./controls/menu": {
      "import": "./dist/components/controls/menu/index.mjs",
      "types": "./dist/components/controls/menu/index.d.ts"
    },
    "./display/spinner": {
      "import": "./dist/components/display/spinner/index.mjs",
      "types": "./dist/components/display/spinner/index.d.ts"
    },
    "./fields/date-input-field": {
      "import": "./dist/components/fields/date-input-field/index.mjs",
      "types": "./dist/components/fields/date-input-field/index.d.ts"
    },
    "./fields/date-range-input-field": {
      "import": "./dist/components/fields/date-range-input-field/index.mjs",
      "types": "./dist/components/fields/date-range-input-field/index.d.ts"
    },
    "./fields/multi-select-input-field": {
      "import": "./dist/components/fields/multi-select-input-field/index.mjs",
      "types": "./dist/components/fields/multi-select-input-field/index.d.ts"
    },
    "./fields/select-input-field": {
      "import": "./dist/components/fields/select-input-field/index.mjs",
      "types": "./dist/components/fields/select-input-field/index.d.ts"
    },
    "./fields/select-text-input-field": {
      "import": "./dist/components/fields/select-text-input-field/index.mjs",
      "types": "./dist/components/fields/select-text-input-field/index.d.ts"
    },
    "./fields/text-input-field": {
      "import": "./dist/components/fields/text-input-field/index.mjs",
      "types": "./dist/components/fields/text-input-field/index.d.ts"
    },
    "./form": {
      "import": "./dist/components/form/index.mjs",
      "types": "./dist/components/form/index.d.ts"
    },
    "./workflow/async-value": {
      "import": "./dist/components/workflow/async-value/index.mjs",
      "types": "./dist/components/workflow/async-value/index.d.ts"
    },
    "./class-builders/hidden": {
      "import": "./dist/class-builders/hidden.mjs",
      "types": "./dist/class-builders/hidden.d.ts"
    },
    "./styles/": {
      "import": "./dist/styles/"
    }
  },
  "watch": {
    "watch:assets": {
      "patterns": [
        "src/assets"
      ],
      "extensions": "png,jpg,svg,gif",
      "ignore": "dist/",
      "quiet": false,
      "runOnChangeOnly": true
    },
    "watch:styles": {
      "patterns": [
        "src/styles"
      ],
      "extensions": "scss,css",
      "quiet": false,
      "runOnChangeOnly": true
    },
    "watch:js": {
      "patterns": [
        "src"
      ],
      "extensions": "js,jsx,json,ts,tsx",
      "quiet": false,
      "runOnChangeOnly": true
    }
  },
  "eslintConfig": {
    "extends": "@config/eslint-config"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.0",
    "@fortawesome/free-regular-svg-icons": "^6.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@reformjs/toolbox": "workspace:*",
    "@reformjs/reactive-data": "workspace:*",
    "@reformjs/reactive-hooks": "workspace:*",
    "@types/lodash": "^4.14.186",
    "@types/react": "^17",
    "@types/react-dom": "^17",
    "@types/shortid": "^0.0.29",
    "classnames": "^2.3.2",
    "date-fns": "2.30.0",
    "fs-extra": "^9.0.1",
    "jest-puppeteer": "^6.2.0",
    "lodash-es": "^4.17.21",
    "prop-types": "^15.8.1",
    "react-text-mask": "^5.5.0",
    "scroll-into-view-if-needed": "^3.0.10",
    "shortid": "^2.2.15",
    "uuid": "^9.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@config/eslint-config": "workspace:*",
    "@config/rollup-config": "workspace:*",
    "@reformjs/web-unit": "workspace:*",
    "@reformjs/web-unit-jest": "workspace:*",
    "@svgr/webpack": "^6.2.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.1.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.2.2",
    "@types/testing-library__jest-dom": "^5.14.5",
    "core-js": "3.4.1",
    "jest": "^29.0.0",
    "jest-cucumber": "^3.0.1",
    "jest-environment-jsdom": "^28.0.0",
    "lorem-ipsum": "^2.0.4",
    "make-dir-cli": "latest",
    "ncp": "2.0.0",
    "npm-watch": "latest",
    "pdfjs-dist": "2.6.347",
    "process": "^0.11.10",
    "rimraf": "^5.0.0",
    "sass": "latest",
    "sass-package-importer": "latest",
    "stylelint": "^9.10.1",
    "stylelint-config-prettier": "^5.1.0",
    "stylelint-config-standard": "^18.2.0",
    "stylelint-scss": "^3.5.3",
    "ts-jest": "^29.0.0",
    "typescript": "~5.3.3",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.11.1",
    "webpack-merge": "5.7.3",
    "webpack-node-externals": "^3.0.0"
  },
  "gitHead": "e00fafa04e0bd313dd2810feaa2dc5d23c3103fd"
}
